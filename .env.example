# Local Typesense settings. The search key is created by npm run search:import.
VITE_TYPESENSE_HOST=localhost
VITE_TYPESENSE_PORT=8108
VITE_TYPESENSE_PROTOCOL=http
# Optional URL prefix, e.g. /typesense when search is proxied through nginx in production.
VITE_TYPESENSE_PATH=
VITE_TYPESENSE_SEARCH_KEY=

# Server and import script only. Never expose this key as a VITE_ variable.
TYPESENSE_ADMIN_KEY=
